{
  "$defs": {
    "JobKind": {
      "enum": [
        "TESSELLATE",
        "SIMULATE",
        "RENDER",
        "EXPORT"
      ],
      "title": "JobKind",
      "type": "string"
    },
    "JobStatus": {
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "JobStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/JobKind"
    },
    "status": {
      "$ref": "#/$defs/JobStatus"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_artifact_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Input Artifact Ids",
      "type": "array"
    },
    "result_artifact_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Result Artifact Ids",
      "type": "array"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    },
    "worker_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Worker Id"
    },
    "attempt_count": {
      "title": "Attempt Count",
      "type": "integer"
    },
    "max_attempts": {
      "title": "Max Attempts",
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "heartbeat_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Heartbeat At"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Lease Expires At"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    }
  },
  "required": [
    "id",
    "project_id",
    "revision_id",
    "kind",
    "status",
    "idempotency_key",
    "input_artifact_ids",
    "result_artifact_ids",
    "parameters",
    "tool_name",
    "tool_version",
    "worker_id",
    "attempt_count",
    "max_attempts",
    "error",
    "created_at",
    "started_at",
    "heartbeat_at",
    "lease_expires_at",
    "finished_at"
  ],
  "title": "JobRead",
  "type": "object"
}
