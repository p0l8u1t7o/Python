{
  "$defs": {
    "CoordinateFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_frame_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Frame Id"
        },
        "length_unit": {
          "const": "mm",
          "default": "mm",
          "title": "Length Unit",
          "type": "string"
        },
        "axis_system": {
          "const": "RIGHT_HANDED_Z_UP",
          "default": "RIGHT_HANDED_Z_UP",
          "title": "Axis System",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision_id",
        "name"
      ],
      "title": "CoordinateFrame",
      "type": "object"
    },
    "FrameTransform": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "parent_frame_id": {
          "format": "uuid",
          "title": "Parent Frame Id",
          "type": "string"
        },
        "child_frame_id": {
          "format": "uuid",
          "title": "Child Frame Id",
          "type": "string"
        },
        "matrix": {
          "$ref": "#/$defs/Matrix4"
        },
        "trust_status": {
          "$ref": "#/$defs/TrustStatus"
        },
        "source": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision_id",
        "parent_frame_id",
        "child_frame_id",
        "matrix",
        "trust_status",
        "source"
      ],
      "title": "FrameTransform",
      "type": "object"
    },
    "FrameTreeRead": {
      "additionalProperties": false,
      "properties": {
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/CoordinateFrame"
          },
          "title": "Frames",
          "type": "array"
        },
        "transforms": {
          "items": {
            "$ref": "#/$defs/FrameTransform"
          },
          "title": "Transforms",
          "type": "array"
        }
      },
      "required": [
        "revision_id",
        "frames",
        "transforms"
      ],
      "title": "FrameTreeRead",
      "type": "object"
    },
    "Matrix4": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/Vector4"
        },
        {
          "$ref": "#/$defs/Vector4"
        },
        {
          "$ref": "#/$defs/Vector4"
        },
        {
          "$ref": "#/$defs/Vector4"
        }
      ],
      "type": "array"
    },
    "ProjectRevision": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/RevisionStatus"
        },
        "parent_revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Revision Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "sequence",
        "status",
        "created_at"
      ],
      "title": "ProjectRevision",
      "type": "object"
    },
    "RevisionStatus": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "RELEASED"
      ],
      "title": "RevisionStatus",
      "type": "string"
    },
    "TrustStatus": {
      "enum": [
        "INFERRED",
        "DRAWING_CONFIRMED",
        "CAD_CONFIRMED",
        "SURVEY_CALIBRATED",
        "RELEASED"
      ],
      "title": "TrustStatus",
      "type": "string"
    },
    "Vector4": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "type": "array"
    }
  },
  "additionalProperties": false,
  "properties": {
    "change_set_id": {
      "format": "uuid",
      "title": "Change Set Id",
      "type": "string"
    },
    "revision": {
      "$ref": "#/$defs/ProjectRevision"
    },
    "frame_tree": {
      "$ref": "#/$defs/FrameTreeRead"
    }
  },
  "required": [
    "change_set_id",
    "revision",
    "frame_tree"
  ],
  "title": "ChangeSetApplyResult",
  "type": "object"
}
