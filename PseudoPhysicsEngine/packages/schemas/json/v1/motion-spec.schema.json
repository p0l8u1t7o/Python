{
  "$defs": {
    "MotionKeyframe": {
      "additionalProperties": false,
      "properties": {
        "time_seconds": {
          "minimum": 0,
          "title": "Time Seconds",
          "type": "number"
        },
        "position": {
          "title": "Position",
          "type": "number"
        }
      },
      "required": [
        "time_seconds",
        "position"
      ],
      "title": "MotionKeyframe",
      "type": "object"
    },
    "MotionTrackSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "scene_node_id": {
          "format": "uuid",
          "title": "Scene Node Id",
          "type": "string"
        },
        "joint_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Joint Name",
          "type": "string"
        },
        "position_unit": {
          "enum": [
            "mm",
            "degree",
            "radian"
          ],
          "title": "Position Unit",
          "type": "string"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/MotionKeyframe"
          },
          "minItems": 2,
          "title": "Keyframes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "scene_node_id",
        "joint_name",
        "position_unit",
        "keyframes"
      ],
      "title": "MotionTrackSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_name": {
      "const": "MotionSpec",
      "default": "MotionSpec",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/MotionTrackSpec"
      },
      "minItems": 1,
      "title": "Tracks",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "revision_id",
    "tracks"
  ],
  "title": "MotionSpec",
  "type": "object"
}
