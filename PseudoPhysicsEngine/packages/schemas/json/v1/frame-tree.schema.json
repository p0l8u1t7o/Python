{
  "$defs": {
    "CoordinateFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_frame_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Frame Id"
        },
        "length_unit": {
          "const": "mm",
          "default": "mm",
          "title": "Length Unit",
          "type": "string"
        },
        "axis_system": {
          "const": "RIGHT_HANDED_Z_UP",
          "default": "RIGHT_HANDED_Z_UP",
          "title": "Axis System",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision_id",
        "name"
      ],
      "title": "CoordinateFrame",
      "type": "object"
    },
    "FrameTransform": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "parent_frame_id": {
          "format": "uuid",
          "title": "Parent Frame Id",
          "type": "string"
        },
        "child_frame_id": {
          "format": "uuid",
          "title": "Child Frame Id",
          "type": "string"
        },
        "matrix": {
          "$ref": "#/$defs/Matrix4"
        },
        "trust_status": {
          "$ref": "#/$defs/TrustStatus"
        },
        "source": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision_id",
        "parent_frame_id",
        "child_frame_id",
        "matrix",
        "trust_status",
        "source"
      ],
      "title": "FrameTransform",
      "type": "object"
    },
    "Matrix4": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/Vector4"
        },
        {
          "$ref": "#/$defs/Vector4"
        },
        {
          "$ref": "#/$defs/Vector4"
        },
        {
          "$ref": "#/$defs/Vector4"
        }
      ],
      "type": "array"
    },
    "TrustStatus": {
      "enum": [
        "INFERRED",
        "DRAWING_CONFIRMED",
        "CAD_CONFIRMED",
        "SURVEY_CALIBRATED",
        "RELEASED"
      ],
      "title": "TrustStatus",
      "type": "string"
    },
    "Vector4": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "type": "array"
    }
  },
  "additionalProperties": false,
  "properties": {
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/CoordinateFrame"
      },
      "title": "Frames",
      "type": "array"
    },
    "transforms": {
      "items": {
        "$ref": "#/$defs/FrameTransform"
      },
      "title": "Transforms",
      "type": "array"
    }
  },
  "required": [
    "revision_id",
    "frames",
    "transforms"
  ],
  "title": "FrameTreeRead",
  "type": "object"
}
