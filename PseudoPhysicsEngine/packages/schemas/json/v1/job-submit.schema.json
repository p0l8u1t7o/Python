{
  "$defs": {
    "JobKind": {
      "enum": [
        "TESSELLATE",
        "SIMULATE",
        "RENDER",
        "EXPORT"
      ],
      "title": "JobKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/JobKind"
    },
    "idempotency_key": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_artifact_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Input Artifact Ids",
      "type": "array"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "tool_name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tool Name",
      "type": "string"
    },
    "tool_version": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Tool Version",
      "type": "string"
    },
    "max_attempts": {
      "default": 3,
      "maximum": 10,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    }
  },
  "required": [
    "project_id",
    "revision_id",
    "kind",
    "idempotency_key",
    "tool_name",
    "tool_version"
  ],
  "title": "JobSubmit",
  "type": "object"
}
