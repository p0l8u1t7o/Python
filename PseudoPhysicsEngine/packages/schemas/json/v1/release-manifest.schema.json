{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "STEP",
        "PARASOLID",
        "SLDPRT",
        "SLDASM",
        "BOM",
        "COORDINATE_REPORT",
        "VALIDATION_REPORT",
        "OTHER"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ReleaseArtifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "uri": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "mime_type": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "uri",
        "sha256",
        "size_bytes",
        "mime_type"
      ],
      "title": "ReleaseArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_name": {
      "const": "ReleaseManifest",
      "default": "ReleaseManifest",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "validation_report_id": {
      "format": "uuid",
      "title": "Validation Report Id",
      "type": "string"
    },
    "approved_by": {
      "format": "uuid",
      "title": "Approved By",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ReleaseArtifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "revision_id",
    "validation_report_id",
    "approved_by",
    "generated_at",
    "artifacts"
  ],
  "title": "ReleaseManifest",
  "type": "object"
}
