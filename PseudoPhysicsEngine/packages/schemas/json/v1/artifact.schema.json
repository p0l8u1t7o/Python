{
  "$defs": {
    "ArtifactFormat": {
      "enum": [
        "STEP",
        "GLB",
        "PDF"
      ],
      "title": "ArtifactFormat",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "original_filename": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Original Filename",
      "type": "string"
    },
    "format": {
      "$ref": "#/$defs/ArtifactFormat"
    },
    "mime_type": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Mime Type",
      "type": "string"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "storage_uri": {
      "pattern": "^objects/sha256/[a-f0-9]{2}/[a-f0-9]{64}$",
      "title": "Storage Uri",
      "type": "string"
    },
    "source": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "revision_id",
    "original_filename",
    "format",
    "mime_type",
    "size_bytes",
    "sha256",
    "storage_uri",
    "source",
    "created_at"
  ],
  "title": "ArtifactRead",
  "type": "object"
}
