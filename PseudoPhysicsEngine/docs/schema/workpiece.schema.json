        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link"
        },
        "free_space": {
          "default": false,
          "title": "Free Space",
          "type": "boolean"
        }
      },
      "title": "Pose",
      "type": "object"
    },
    "Rect": {
      "additionalProperties": true,
      "properties": {
        "u": {
          "title": "U",
          "type": "number"
        },
        "v": {
          "title": "V",
