        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        },
        "trust": {
          "default": "inferred",
          "enum": [
            "inferred",
            "confirmed"
          ],
          "title": "Trust",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Size3D",
      "type": "object"
    },
    "Sku": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/Size3D"
        },
        "mass_kg": {
          "title": "Mass Kg",
          "type": "number"
        },
        "covers": {
          "items": {
            "$ref": "#/$defs/Cover"
          },
          "title": "Covers",
          "type": "array"
        },
        "ports": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Ports",
