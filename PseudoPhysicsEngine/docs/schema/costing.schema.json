      "type": "object"
    },
    "Pricing": {
      "additionalProperties": true,
      "description": "銷售報價：margin 為毛利率（售價 = 成本 ÷ (1 − 毛利率)），markup 為加價率\n（售價 = 成本 × (1 + 加價率)），兩者擇一、不可混用。",
      "properties": {
        "method": {
          "enum": [
            "margin",
            "markup"
          ],
          "title": "Method",
          "type": "string"
        },
        "rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Rate"
        },
        "basis": {
          "default": "",
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "method",
        "rate"
      ],
      "title": "Pricing",
      "type": "object"
    },
    "Rounding": {
      "additionalProperties": true,
      "description": "捨入階段：明細小計到 line_decimals；預備費、稅額與報價到 total_decimals。",
      "properties": {
        "line_decimals": {
          "default": 2,
          "title": "Line Decimals",
          "type": "integer"
        },
        "total_decimals": {
          "default": 0,
          "title": "Total Decimals",
          "type": "integer"
        },
        "mode": {
          "default": "half_up",
          "enum": [
            "half_up",
            "half_even"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "Rounding",
      "type": "object"
    }
