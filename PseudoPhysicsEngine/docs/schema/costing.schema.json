{
  "$defs": {
    "BomLine": {
      "additionalProperties": true,
      "description": "不隨模組實例增減的固定列（例如控制器、安全元件）；for 標示所屬設備以檢查重複。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item": {
          "title": "Item",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "for": {
          "items": {
            "type": "string"
          },
          "title": "For",
          "type": "array"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "id",
        "item",
        "quantity"
      ],
      "title": "BomLine",
      "type": "object"
    },
    "ComponentRef": {
      "additionalProperties": true,
      "properties": {
        "item": {
          "title": "Item",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        }
      },
      "required": [
        "item",
        "quantity"
      ],
      "title": "ComponentRef",
      "type": "object"
    },
    "CostItem": {
      "additionalProperties": true,
      "description": "採購項型錄：同一料號只列一次，由設備對應與 BOM 列引用。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "purchased",
            "fabricated",
            "consumable",
            "module",
            "service"
          ],
          "title": "Kind",
          "type": "string"
        },
        "subsystem": {
          "title": "Subsystem",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "price": {
          "$ref": "#/$defs/Price"
        },
        "spec": {
          "default": "",
          "title": "Spec",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "supplier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supplier"
        },
        "part_no": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part No"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "alternative": {
          "default": "",
          "title": "Alternative",
          "type": "string"
        },
        "applies_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies To"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentRef"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "subsystem",
        "name",
        "unit"
      ],
      "title": "CostItem",
      "type": "object"
    },
    "CostPolicy": {
      "additionalProperties": true,
      "properties": {
        "currency": {
          "default": "TWD",
          "title": "Currency",
          "type": "string"
        },
        "overhead_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Overhead Rate"
        },
        "contingency_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Contingency Rate"
        },
        "tax_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Tax Rate"
        },
        "rounding": {
          "$ref": "#/$defs/Rounding"
        },
        "pricing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pricing"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CostPolicy",
      "type": "object"
    },
    "EquipmentMatch": {
      "additionalProperties": true,
      "description": "選出 cell.yaml 的模組實例；多個條件須同時成立。",
      "properties": {
        "part": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
