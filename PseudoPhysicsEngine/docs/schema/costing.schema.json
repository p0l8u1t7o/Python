        "module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        }
      },
      "title": "EquipmentMatch",
      "type": "object"
    },
    "EquipmentRule": {
      "additionalProperties": true,
      "description": "每個符合條件的模組實例各計一次 items；增刪設備時採購數量與成本自動同步。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "match": {
          "$ref": "#/$defs/EquipmentMatch"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ItemQuantity"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "id",
        "match",
        "items"
      ],
      "title": "EquipmentRule",
      "type": "object"
    },
    "ExchangeRate": {
      "additionalProperties": true,
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
