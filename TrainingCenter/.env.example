# 複製成 .env 後填入（.env 已在 .gitignore，不會進版控）。改完要 .\stop.ps1 再 .\start.ps1

# ---- AI 產碼 provider（預設 gemini）----
CAD_STUDIO_PROVIDER=gemini

# Google Gemini：免費金鑰 https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# 選填：模型（預設 gemini-pro-latest；404/429 時自動改試 gemini-3.1-pro-preview → gemini-flash-latest → gemini-2.5-flash）
# CAD_STUDIO_MODEL=gemini-flash-latest

# 其他 OpenAI 相容端點（Groq / OpenRouter / Ollama 本機…）：把 PROVIDER 改成 openai_compat
# CAD_STUDIO_PROVIDER=openai_compat
# CAD_STUDIO_BASE_URL=https://api.groq.com/openai/v1
# CAD_STUDIO_API_KEY=gsk_...
# CAD_STUDIO_MODEL=llama-3.3-70b-versatile
#   Ollama 本機：CAD_STUDIO_BASE_URL=http://localhost:11434/v1、CAD_STUDIO_MODEL=qwen2.5-coder:32b，不需金鑰

# Claude（選用）：CAD_STUDIO_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...

# 選填：cadgen 環境不在 cad/.venv 時指定
# CAD_PYTHON=D:\path\to\python.exe
