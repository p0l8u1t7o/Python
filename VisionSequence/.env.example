# 複製為 .env 後修改。所有值都有預設，不設定也能跑。

# Django
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Taipei
LOG_LEVEL=INFO
# 資料目錄（SQLite、資產）
DATA_DIR=./data

# ---- 視覺引擎 ----
# 同時執行的檢測流程上限（執行緒池大小）
VISION_MAX_WORKERS=10
# 同一流程排隊上限，超過回 429
VISION_MAX_QUEUE_PER_FLOW=16
# 單次 run 逾時（秒）
VISION_RUN_TIMEOUT_S=30
# 每個流程在記憶體保留幾次 run 的影像
VISION_KEEP_RUN_IMAGES=8
# 影像封存：出貨預設不存（各流程自己開）。ng＝只存不良與失敗，all＝每次都存
VISION_ARCHIVE_DEFAULT=off
VISION_ARCHIVE_DAYS=90
VISION_ARCHIVE_MAX_GB=20
# 影像快取總量（MB）
VISION_IMAGE_CACHE_MB=1024
# 是否把每次 run 寫進資料庫（背景批次）
VISION_PERSIST_RUNS=1
# 每流程資料庫保留的 run 列數
VISION_KEEP_RUN_ROWS=2000
# 流程版本快照保留幾版（已發行的版本永遠保留）
VISION_KEEP_VERSIONS=50
# 操作紀錄（誰改了什麼）保留天數；0＝永久保留
VISION_AUDIT_DAYS=730
# OpenCV 執行緒數（多流程並行建議 1～2）
VISION_CV_THREADS=2
# 資料夾外掛：這個資料夾下的 .py 啟動時自動掛載（工具／影像來源／整合連線都用繼承，
# 丟進去就會被偵測，不用改本檔），見 docs/plugins.html。預設專案根目錄 plugins/。
VISION_PLUGIN_DIR=
# 進階：也可用模組路徑手動掛載（逗號分隔），例如 mypkg.my_tools
VISION_TOOL_PLUGINS=
# 進階：影像來源外掛 kind=module:Class，例如 gige=mypkg.gige:GigEGrabber
VISION_SOURCE_PLUGINS=
# 進階：整合連線外掛 kind=module:Class，例如 opcua=mypkg.opcua:OpcUaWriter
# 內建 kind：modbus_tcp、tcp_client、dio_sim（見 docs/modbus.html）
VISION_COMM_PLUGINS=
# 選填 API 金鑰；設定後所有 /api 要帶 X-API-Key
VISION_API_KEY=
# 站台識別（寫進每筆執行紀錄與回傳）
VISION_STATION_ID=ST01
# TCP 自動化介面
VISION_TCP_HOST=0.0.0.0
VISION_TCP_PORT=9000

# 擷取端（相機電腦上的擷取程式）連入埠；同機走共享記憶體、跨機走 TCP
VISION_CAPTURE_HOST=0.0.0.0
VISION_CAPTURE_PORT=9100
# 擷取端登錄金鑰；空＝沿用 VISION_API_KEY（兩者皆空則不驗證）
VISION_CAPTURE_AUTH=

# ---- AI 助手（apps/vision/agent）----
# 伺服器預設供應商：offline | claude | openai | gemini（空＝有金鑰就 claude，沒有就離線規則引擎）。
# 使用者在「AI 助手 → AI 供應商」存的個人設定優先於這裡；金鑰只存伺服器。
VISION_AGENT_PROVIDER=
VISION_AGENT_API_KEY=
# 空＝各供應商預設（claude-opus-5 / gpt-4o / gemini-3.6-flash）
VISION_AGENT_MODEL=

# ---- 前端獨立部署 ----
# 前端不與 API 同站時，列出允許的來源（逗號分隔）；前端 build 時另設 VITE_API_BASE_URL=https://host/api
CORS_ALLOWED_ORIGINS=
# OpenAI 相容本地端點（Ollama／vLLM／LM Studio）：設了就可選 openai_compatible，金鑰可留空
VISION_AGENT_BASE_URL=
# LLM 生成逾時（秒）；本地模型慢可拉長
VISION_AGENT_TIMEOUT_S=120
# 批次測試：影像集上限張數、每流程保留影像集數、每影像集保留執行次數、同時執行的批次數
VISION_BATCH_MAX_IMAGES=200
VISION_KEEP_BATCH_SETS=10
VISION_KEEP_BATCH_RUNS=20
VISION_BATCH_MAX_RUNNING=2

# 深度學習教導：SAM 智慧選取／全圖提案的權重（sam2.1_t.pt 預設；mobile_sam.pt 較小較快、sam2.1_s.pt 更準）
VISION_SAM_MODEL=sam2.1_t.pt
