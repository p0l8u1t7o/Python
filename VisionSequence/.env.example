# 複製為 .env 後修改。所有值都有預設，不設定也能跑。
# 正式環境（客戶 PC）至少要改：SECRET_KEY（隨機長字串）、DEBUG=0、ALLOWED_HOSTS（主機名與 IP，逗號分隔）、
# VISION_API_KEY／VISION_CAPTURE_AUTH／VISION_TCP_AUTH（隨機金鑰）——安裝程式（scripts/install.ps1）會自動產生。
# 發行版的 .env 放在安裝根目錄（<VS_HOME>），與 app\<版本>\ 分開，升級不會被覆蓋。

# Django
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Taipei
LOG_LEVEL=INFO
# 資料目錄（SQLite、資產、封存、備份、日誌）；預設 <VS_HOME>/data
DATA_DIR=./data
# 資料庫檔案位置（預設 DATA_DIR/vision.sqlite3）
DB_PATH=
# 使用者權杖有效期（小時）；操作站可拉長，例如 720
AUTH_TOKEN_TTL_HOURS=336
# 前面有 HTTPS 反向代理（Caddy／nginx）時設 1：相信代理的 X-Forwarded-Proto／Host
BEHIND_HTTPS_PROXY=0

# ---- 視覺引擎 ----
# 同時執行的檢測流程上限（執行緒池大小）
VISION_MAX_WORKERS=10
# 同一流程排隊上限，超過回 429
VISION_MAX_QUEUE_PER_FLOW=16
# 單次 run 逾時（秒）
VISION_RUN_TIMEOUT_S=30
# Silent startup warmup: off | commissioned | all. Default off keeps existing deployments unchanged.
VISION_WARMUP=off
# Per-flow warmup deadline in seconds.
VISION_WARMUP_TIMEOUT_S=30
# Optional comma-separated flow ids. Empty means use VISION_WARMUP selection.
VISION_WARMUP_FLOWS=
# 流程節點／連線數上限、傳給前端的預覽影像最長邊
VISION_MAX_NODES=300
VISION_MAX_EDGES=600
VISION_PREVIEW_MAX_SIDE=1600
# 每個流程在記憶體保留幾次 run 的影像
VISION_KEEP_RUN_IMAGES=8
# 影像封存：出貨預設不存（各流程自己開）。ng＝只存不良與失敗，all＝每次都存
VISION_ARCHIVE_DEFAULT=off
VISION_ARCHIVE_DAYS=90
VISION_ARCHIVE_MAX_GB=20
# 封存影像目錄（預設 DATA_DIR/archive）；範本／模型等資產目錄（預設 DATA_DIR/assets）
VISION_ARCHIVE_DIR=
# 使用者檔案輸出：write_log 與 save_image 的背景寫入根目錄（預設 DATA_DIR/file_outputs）
VISION_FILE_OUTPUT_DIR=
VISION_FILE_OUTPUT_DAYS=90
VISION_FILE_OUTPUT_MAX_GB=20
VISION_FILE_OUTPUT_QUEUE=1000
VISION_ASSET_DIR=
# 影像快取總量（MB）
VISION_IMAGE_CACHE_MB=1024
# 是否把每次 run 寫進資料庫（背景批次）
VISION_PERSIST_RUNS=1
# 每流程資料庫保留的 run 列數
# 執行明細保留天數（每小時彙總永久保留，趨勢圖查彙總）
VISION_KEEP_RUN_DAYS=365
# 每流程明細筆數上限（天數之外的保險）
VISION_KEEP_RUN_ROWS=20000
# 量測值 SPC：把具名數值輸出另存一張輕量表（統計頁「量測值」分頁用），1＝開、0＝關
VISION_MEASUREMENT_LOG=1
# 量測值保留天數（獨立於明細；0＝永久）
VISION_MEASUREMENT_DAYS=365
# 流程版本快照保留幾版（已發行的版本永遠保留）
VISION_KEEP_VERSIONS=50
# 操作紀錄（誰改了什麼）保留天數；0＝永久保留
VISION_AUDIT_DAYS=365
# 備份 zip 與還原前資料庫副本各保留幾份（0＝全部保留）
VISION_KEEP_BACKUPS=10
# 維護時段（當地時間的整點）：備份整理與資料庫空間回收在這一小時做
VISION_MAINTENANCE_HOUR=3
# 伺服器閒置時自動清理過期資料（這些天數是出廠值，設定頁改的值存在資料庫）
VISION_RETENTION_SWEEP=1
# OpenCV 執行緒數（多流程並行建議 1～2）
VISION_CV_THREADS=2
# 前處理加速：auto（偵測到 OpenCL 就用）｜cpu｜opencl｜cuda；只對大圖（≥ VISION_ACCEL_MIN_PIXELS 像素）的重取樣／中值／卷積／FFT 生效
VISION_ACCEL=auto
VISION_ACCEL_MIN_PIXELS=4000000
# 資料夾外掛：這個資料夾下的 .py 啟動時自動掛載（工具／影像來源／整合連線都用繼承，
# 丟進去就會被偵測，不用改本檔），見 docs/plugins.html。預設 <VS_HOME>/plugins（開發＝專案根目錄 plugins/）。
VISION_PLUGIN_DIR=
# 進階：也可用模組路徑手動掛載（逗號分隔），例如 mypkg.my_tools
VISION_TOOL_PLUGINS=
# 進階：影像來源外掛 kind=module:Class，例如 gige=mypkg.gige:GigEGrabber
VISION_SOURCE_PLUGINS=
# 進階：整合連線外掛 kind=module:Class，例如 opcua=mypkg.opcua:OpcUaWriter
# 內建 kind：modbus_tcp、modbus_server、tcp_client、tcp_image（見 docs/modbus.html）
VISION_COMM_PLUGINS=
# 選填 API 金鑰；設定後所有 /api 要帶 X-API-Key
VISION_API_KEY=
# 站台識別（寫進每筆執行紀錄與回傳）
VISION_STATION_ID=ST01
# HTTP 埠（manage.py serve 預設；有 HTTPS 反向代理時 serve 綁 127.0.0.1、由代理對外）
VISION_HTTP_PORT=8000
# TCP 自動化介面
VISION_TCP_HOST=0.0.0.0
VISION_TCP_PORT=9000
# TCP 介面金鑰：非空時設備連線後要先送「AUTH <金鑰>」（PING 除外）；空＝不驗證，只靠防火牆
VISION_TCP_AUTH=
# SSE 事件串流同時連線上限（每個開著的瀏覽器分頁一條；超過回 503，瀏覽器會稍後重試）
VISION_SSE_MAX_STREAMS=64

# 擷取端（相機電腦上的擷取程式）連入埠；同機走共享記憶體、跨機走 TCP
VISION_CAPTURE_HOST=0.0.0.0
VISION_CAPTURE_PORT=9100
# 擷取端登錄金鑰；空＝沿用 VISION_API_KEY（兩者皆空則不驗證）
VISION_CAPTURE_AUTH=
# 擷取端單張影像上限（MB，超過即斷線）與「依需求取像」預設逾時（毫秒）
VISION_CAPTURE_MAX_FRAME_MB=128
VISION_CAPTURE_TIMEOUT_MS=1000

# ---- AI 助手（apps/vision/agent）----
# 伺服器預設供應商：offline | claude | openai | gemini（空＝有金鑰就 claude，沒有就離線規則引擎）。
# 使用者在「AI 助手 → AI 供應商」存的個人設定優先於這裡；金鑰只存伺服器。
VISION_AGENT_PROVIDER=
VISION_AGENT_API_KEY=
# 空＝各供應商預設（claude-opus-5 / gpt-4o / gemini-3.6-flash）
VISION_AGENT_MODEL=

# ---- 前端獨立部署 ----
# 前端不與 API 同站時，列出允許的來源（逗號分隔）；前端 build 時另設 VITE_API_BASE_URL=https://host/api
CORS_ALLOWED_ORIGINS=
# OpenAI 相容本地端點（Ollama／vLLM／LM Studio）：設了就可選 openai_compatible，金鑰可留空
VISION_AGENT_BASE_URL=
# LLM 生成逾時（秒）；本地模型慢可拉長
VISION_AGENT_TIMEOUT_S=120
# 助手工作模式：single（一次生成）| agentic（代理迴圈：試跑→修→驗證）
VISION_AGENT_MODE=single
# 全域 AI 助手問答時可用唯讀查詢看平台即時狀態（流程、來源、連線、執行報告、鎖定、外掛）；0＝只依文件回答
VISION_AGENT_HELP_LOOKUPS=1
# 批次測試：影像集上限張數、每流程保留影像集數、每影像集保留執行次數、同時執行的批次數
VISION_BATCH_MAX_IMAGES=200
VISION_KEEP_BATCH_SETS=10
VISION_KEEP_BATCH_RUNS=20
VISION_BATCH_MAX_RUNNING=2

# 深度學習教導：SAM 智慧選取／全圖提案的權重（sam2.1_t.pt 預設；mobile_sam.pt 較小較快、sam2.1_s.pt 更準）
VISION_SAM_MODEL=sam2.1_t.pt
