# 複製為 .env 後修改。所有值都有預設，不設定也能跑。

# Django
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Taipei
LOG_LEVEL=INFO
# 資料目錄（SQLite、資產）
DATA_DIR=./data

# ---- 視覺引擎 ----
# 同時執行的檢測流程上限（執行緒池大小）
VISION_MAX_WORKERS=10
# 同一流程排隊上限，超過回 429
VISION_MAX_QUEUE_PER_FLOW=4
# 單次 run 逾時（秒）
VISION_RUN_TIMEOUT_S=30
# 每個流程在記憶體保留幾次 run 的影像
VISION_KEEP_RUN_IMAGES=8
# 影像快取總量（MB）
VISION_IMAGE_CACHE_MB=1024
# 是否把每次 run 寫進資料庫（背景批次）
VISION_PERSIST_RUNS=1
# 每流程資料庫保留的 run 列數
VISION_KEEP_RUN_ROWS=2000
# OpenCV 執行緒數（多流程並行建議 1～2）
VISION_CV_THREADS=2
# 外掛工具模組（逗號分隔），例如 plugins.my_tools
VISION_TOOL_PLUGINS=
# 影像來源外掛：kind=module:Class，例如 gige=plugins.gige:GigESource
VISION_SOURCE_PLUGINS=
# 通訊連線外掛（主動輸出到 PLC）：kind=module:Class，例如 opcua=plugins.opcua:OpcUaWriter
# 內建 kind：modbus_tcp、tcp_client、dio_sim（見 docs/plc.html）
VISION_COMM_PLUGINS=
# 選填 API 金鑰；設定後所有 /api 要帶 X-API-Key
VISION_API_KEY=
# 站台識別（寫進每筆執行紀錄與回傳）
VISION_STATION_ID=ST01
# TCP 自動化介面
VISION_TCP_HOST=0.0.0.0
VISION_TCP_PORT=9000
