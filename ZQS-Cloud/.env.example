# ==========================================================================
# ZQS Cloud - 環境設定（.env）
#
# 用法：複製成 .env 後依環境修改；.env 不進版控。config/env.py 在啟動時讀取
# 一次（已存在於系統環境變數的值優先，.env 不會覆蓋）。
# 布林值可寫 1/0、true/false、yes/no；清單用逗號分隔。
# 每個值後面標的是「程式內建預設」：整行刪掉或留空（字串類）就等於用預設。
# 大多數開發情境只要動「Django」「MQTT」「內部訊息匯流排」三段；其餘維持預設。
# ==========================================================================


# ---- Django ----------------------------------------------------------------
# 設定模組：config.settings.dev（開發：DEBUG、任何 Host、CORS 全開、沒設
# BUS_BACKEND 時用 memory）或 config.settings.prod（正式：強制 HTTPS、HSTS、
# 必須提供 DJANGO_SECRET_KEY）。
DJANGO_SETTINGS_MODULE=config.settings.dev

# 簽章用密鑰（session、JWT 預設也用它）。正式環境一定要換，產生方式：
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-before-production

# Django DEBUG。dev 設定模組會強制 True；這裡只影響 prod。預設 0。
DJANGO_DEBUG=0

# 允許的 Host 標頭（逗號分隔）。dev 模組固定接受全部（*），手機用區網 IP
# 連進來不用改；prod 請填實際網域。預設 *。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 記錄等級：DEBUG | INFO | WARNING | ERROR。dev 預設 DEBUG、prod 預設 INFO。
LOG_LEVEL=INFO
# 1 = 以 JSON 一行一筆輸出（給 Loki/ELK 收），0 = 人類可讀格式。預設 0。
LOG_JSON=0

# 只在 prod 模組生效：是否把 http 轉向 https（預設 1）與 HSTS 秒數（預設 1 年）。
# 反向代理已經做 TLS 終結時通常設 SECURE_SSL_REDIRECT=0。
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000


# ---- 資料庫 ----------------------------------------------------------------
# sqlite（預設，單機開發）| postgres | timescale（PostgreSQL + TimescaleDB，
# 時序資料量大時用）。sqlite 時 DB_NAME 是檔案路徑，預設 data/zqs_cloud.sqlite3。
DB_ENGINE=sqlite
# 以下只有 postgres / timescale 會用到。
# DB_NAME=zqs_cloud
# DB_USER=zqs
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# 連線逾時秒數（預設 10）與連線重用秒數（預設 60；0 = 每個請求重連）。
# DB_CONNECT_TIMEOUT=10
# DB_CONN_MAX_AGE=60


# ---- 前端 / 介面 -----------------------------------------------------------
# 允許呼叫 API 的瀏覽器來源（逗號分隔）。dev 模組全開；prod 填 console 網址。
# 預設 http://localhost:5173,http://127.0.0.1:5173。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 瀏覽器表單（admin、API docs）信任的 CSRF 來源；沒設就沿用 CORS_ALLOWED_ORIGINS。
# dev 模組會再自動加上本機每個區網 IP 的 5173/8000。
# CSRF_TRUSTED_ORIGINS=

# 新使用者 / 未指定語言時的介面語言：en | zh-Hant | zh-Hans。預設 en。
DEFAULT_LANGUAGE=en
# Django 內部時區（資料庫一律存 UTC，維持 UTC 即可）。預設 UTC。
TIME_ZONE=UTC
# 新增場域時表單留空的預設時區；場域時區決定「今日」與時間電價的界線。
# 預設 Asia/Taipei。
SITE_DEFAULT_TIMEZONE=Asia/Taipei


# ---- JWT（登入權杖）-------------------------------------------------------
# 簽章密鑰；留空 = 用 DJANGO_SECRET_KEY。要讓 API 與其他服務分開輪換時才設。
# JWT_SIGNING_KEY=
# 演算法與 issuer，一般不用改。預設 HS256 / zqs-cloud。
# JWT_ALGORITHM=HS256
# JWT_ISSUER=zqs-cloud
# access token 壽命（秒，預設 900 = 15 分鐘）；到期由 refresh token 換新。
JWT_ACCESS_TTL_SECONDS=900
# refresh token 壽命（秒，預設 1209600 = 14 天）；超過要重新登入。
JWT_REFRESH_TTL_SECONDS=1209600


# ---- MQTT / EMQX -----------------------------------------------------------
# 0 = 這個部署沒有 broker：即時擷取與下行命令不可用，健康度卡片會顯示
# 「未使用」而不是連線失敗。預設 1。
MQTT_ENABLED=1
# broker 位址與埠。ingestor/worker 用來連 broker；內建開發 broker
# （manage.py run_broker）也用它當綁定位址（dev.ps1 -Lan 時改綁 0.0.0.0）。
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# 平台自己（host application）連 broker 的帳密；內建開發 broker 匿名，留空。
MQTT_USERNAME=
MQTT_PASSWORD=
# 平台 client id 的前綴（預設 zqs）。設備端的慣例是 zqs:<node id>，這裡是平台端。
# MQTT_CLIENT_ID_PREFIX=zqs
# 協定版本：5 或 311。EMQX 兩者都可；內建開發 broker 只支援 3.1.1，
# dev.ps1 啟動內建 broker 時會自動改成 311。預設 5。
MQTT_PROTOCOL_VERSION=5
# keepalive 秒數（預設 45）；斷線偵測時間約為它的 1.5 倍。
MQTT_KEEPALIVE=45
# 訂閱上行（設備 → 平台）與發布下行（命令）的 QoS。預設上行 1、下行 0。
MQTT_QOS_UPLINK=1
MQTT_QOS_DOWNLINK=1
# 重連退避的最小 / 最大秒數。預設 1 / 60。
# MQTT_RECONNECT_MIN_DELAY=1
# MQTT_RECONNECT_MAX_DELAY=60
# 共享訂閱（$share/<group>/...）讓多個 ingestor 副本分攤 topic；需要 MQTT 5
# 與 EMQX。內建 broker 不支援，dev.ps1 會自動關掉。預設 1。
MQTT_USE_SHARED_SUBSCRIPTION=1
MQTT_SHARED_GROUP=zqs-ingestor
# TLS（通常配 8883 埠）。CA 憑證必填；client 憑證 / 私鑰只有 mTLS 才需要。
MQTT_TLS_ENABLED=0
# MQTT_TLS_CA_CERT=/etc/zqs/certs/ca.pem
# MQTT_TLS_CERTFILE=/etc/zqs/certs/client.pem
# MQTT_TLS_KEYFILE=/etc/zqs/certs/client.key
# 1 = 不驗證 broker 憑證（只給測試自簽憑證用，正式環境勿開）。預設 0。
MQTT_TLS_INSECURE=0

# EMQX 呼叫平台的認證 / ACL webhook（/api/emqx/auth、/api/emqx/acl）時帶在
# X-EMQX-Token 的共用密鑰。留空 = 這兩個端點停用（內建 broker 模式不需要）。
# 設備的 MQTT 帳密就是靠這個 webhook 驗證的：EMQX 收到 CONNECT → 問平台 →
# 平台查閘道器憑證。
EMQX_WEBHOOK_TOKEN=


# ---- Sparkplug B -----------------------------------------------------------
# Host Application ID：平台在 STATE/<host id> topic 上宣告自己上線。同一個
# broker 上有多套平台時必須不同。預設 zqs-cloud。設備端不需要知道。
SPARKPLUG_HOST_ID=zqs-cloud


# ---- 內部訊息匯流排（ingestor → worker）------------------------------------
# redis（預設；Redis Streams，可多副本）| rabbitmq | memory（單一行程內、
# 不落地；只給開發用，ingestor 與 worker 必須跑在同一個 run_pipeline 行程）。
# dev 模組在這個值留空時自動用 memory。
BUS_BACKEND=redis
# redis 時的連線字串。
REDIS_URL=redis://127.0.0.1:6379/0
# rabbitmq 時的連線字串。
AMQP_URL=amqp://guest:guest@127.0.0.1:5672/%2F
# Stream / queue 名稱前綴與消費者群組名；同一個 Redis 跑多套平台時改前綴。
BUS_STREAM_PREFIX=zqs
BUS_CONSUMER_GROUP=zqs-workers
# 每個 stream 最多保留的訊息數（Redis 用 MAXLEN 近似修剪）。預設 1000000。
BUS_MAX_STREAM_LENGTH=1000000
# 訊息被領走但一直沒 ack（worker 掛了）超過這個毫秒數，就讓別的 worker 接手。
# 預設 60000。
BUS_CLAIM_MIN_IDLE_MS=60000


# ---- 快取 ------------------------------------------------------------------
# locmem（預設，每個行程各自一份）| redis（多個 API 副本共用）。
CACHE_BACKEND=locmem
# redis 時的連線字串；沒設就沿用 REDIS_URL。
# CACHE_REDIS_URL=redis://127.0.0.1:6379/1


# ---- 擷取（ingestor）--------------------------------------------------------
# 時間戳容許範圍：比現在晚超過 FUTURE 秒、或早超過 PAST 秒的 metric 會被丟棄
# （設備時鐘不對、或斷線後回補太舊的資料）。預設 300 / 604800（7 天）。
INGEST_MAX_SKEW_FUTURE_S=300
INGEST_MAX_SKEW_PAST_S=604800
# 單一 MQTT payload 的大小上限（bytes，預設 262144 = 256 KiB）。
INGEST_MAX_PAYLOAD_BYTES=262144
# 單一 payload 的 metric 數上限（預設 512）；超過整則拒收。
INGEST_MAX_METRICS_PER_MESSAGE=512
# 1 = 未登記的閘道器（NBIRTH 的 group 對得上租戶）與設備（DBIRTH）在第一次
# 上行時自動建檔，設備進入「待驗收」：量測值照收，但所有能力關閉、拒絕命令，
# 直到有人在設備頁指定類型並確認。0（預設）= 未登記的一律丟棄，只在閘道器頁
# 的「連線偵錯」留下 unknown_device / unknown_node 紀錄。
INGEST_AUTO_PROVISION=0
# （保留欄位，目前程式未使用：租戶由 topic 的 group id 決定，不會退回預設租戶。）
INGEST_AUTO_PROVISION_ORG=default


# ---- Worker ----------------------------------------------------------------
# 一批最多處理幾則訊息（預設 500）；到數量或到時間就寫入資料庫。
WORKER_BATCH_SIZE=500
# 批次最長等待毫秒數（預設 2000）：訊息少時最多延遲這麼久才落地。
WORKER_FLUSH_INTERVAL_MS=2000
# 從匯流排讀取時的阻塞等待毫秒數（預設 1000）。
WORKER_BLOCK_MS=1000
# 閘道器 / 設備登錄表在 worker 記憶體裡的快取秒數（預設 30）：在 Web 上新
# 登記的設備最晚這麼久後生效。
WORKER_REGISTRY_CACHE_TTL_S=30
# 一則訊息處理失敗的重試次數（預設 3），之後丟棄並記錄。
WORKER_MAX_RETRIES=3


# ---- 設備生命週期 ----------------------------------------------------------
# 設備 / 閘道器多久沒有任何上行就判離線（秒，預設 180）。這是沒收到遺言
# （NDEATH/DDEATH）時的後備機制；有遺言時 broker 一送就立即離線。
DEVICE_OFFLINE_GRACE_SECONDS=180
# 下行命令沒有收到回覆（Command/Status）就判逾時的秒數（預設 60）。
COMMAND_DEFAULT_TIMEOUT_SECONDS=60


# ---- 工作流程引擎 ----------------------------------------------------------
# 每個租戶同時可執行的流程數（預設 5）。伺服器端設定，操作者無法在介面調高，
# 因為它保護的是大家共用的那台機器。
WORKFLOW_MAX_CONCURRENT_RUNS=12
# 引擎的 tick 秒數（預設 2）：畫布上每個計時器 / 等待節點的時間解析度。
WORKFLOW_TICK_SECONDS=2
# 條件節點讀到的量測值最多可以多舊（秒，預設 300）；更舊視為沒有資料。
# WORKFLOW_MAX_READING_AGE_S=300
# 單次 tick 內一個流程最多前進的步數（預設 200）與整個 run 的步數上限
# （預設 0 = 不限）；用來擋住畫成無窮迴圈的流程。
# WORKFLOW_MAX_STEPS_PER_CALL=200
# WORKFLOW_MAX_STEPS_PER_RUN=0


# ---- 電子郵件通知 ----------------------------------------------------------
# 警報 / 通知的預設 SMTP。每個通知管道也可以在介面上帶自己的 SMTP 設定
# （優先）。兩邊都沒有時，郵件管道會明確拒送並顯示原因，不會靜默丟掉。
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# STARTTLS（預設 1）。
EMAIL_USE_TLS=true
# 寄件人；預設 zqs-cloud@localhost。
DEFAULT_FROM_EMAIL=zqs-cloud@example.com


# ---- 地址轉座標 ------------------------------------------------------------
# 新增場域時用地址查經緯度，走 OpenStreetMap Nominatim（免費、免金鑰）。
# 0 = 關閉查詢，手動輸入座標仍可用。預設 1。
GEOCODING_ENABLED=1
# Nominatim 的使用政策要求帶可識別的 User-Agent；請改成你的名稱與聯絡方式。
GEOCODING_USER_AGENT=ZQS-Cloud/1.0 (energy platform)
# 自架 Nominatim 時改這裡；查詢逾時秒數預設 8。
# GEOCODING_ENDPOINT=https://nominatim.openstreetmap.org/search
# GEOCODING_TIMEOUT_S=8


# ---- 報表匯出 --------------------------------------------------------------
# PDF 用的中文字型（.ttf/.ttc）。留空時依序找 Windows 的微軟正黑體、Noto Sans TC、
# Linux 的 Noto CJK；都沒有會退回 Helvetica（中文變方框）。Linux 伺服器建議裝
# fonts-noto-cjk 或在這裡指定字型檔。Word 不需要字型，由開啟的電腦處理。
# REPORT_FONT_PATH=


# ---- API -------------------------------------------------------------------
# 分頁預設筆數（預設 50）與單頁上限（預設 1000）。
API_PAGE_SIZE=50
API_PAGE_MAX_SIZE=1000
# 使用者密碼最短長度（預設 10）。
PASSWORD_MIN_LENGTH=10


# ---- 只給腳本 / 工具用（Python 設定不讀）-----------------------------------
# scripts/run_device_test.py 等工具用的 API 位址（預設 127.0.0.1:8000）。
# ZQS_API_BIND=127.0.0.1:8000
# 設備測試工具連 broker 時用的設備密碼（登錄 / 輪換憑證時取得）。
# ZQS_DEVICE_PASSWORD=
# 前端開發伺服器綁定位址：0.0.0.0 讓區網裝置連進來（dev.ps1 -Lan 會自動設）。
# VITE_DEV_HOST=127.0.0.1
# Playwright e2e 測試的目標網址（預設 http://127.0.0.1:5173）。
# E2E_BASE_URL=http://127.0.0.1:5173
