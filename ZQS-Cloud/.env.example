# --------------------------------------------------------------------------
# ZQS Cloud - environment configuration
# Copy to .env and edit. Every value below is the built-in default.
# --------------------------------------------------------------------------

# ---- Django --------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-before-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
LOG_JSON=0

# ---- Database ------------------------------------------------------------
# sqlite (default) | postgres | timescale
DB_ENGINE=sqlite
# DB_NAME=zqs_cloud
# DB_USER=zqs
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ---- Front end -----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_LANGUAGE=en
TIME_ZONE=UTC
# Timezone a new site gets when the form leaves it blank.
SITE_DEFAULT_TIMEZONE=Asia/Taipei

# ---- JWT -----------------------------------------------------------------
# Defaults to DJANGO_SECRET_KEY when unset.
# JWT_SIGNING_KEY=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# ---- MQTT / EMQX ---------------------------------------------------------
# 0 when this deployment runs without a broker. Live ingest and downlink
# commands are then unavailable, and the health card says so plainly instead
# of reporting a connection failure that is not actually a fault.
MQTT_ENABLED=1
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# 5 or 311. EMQX speaks both; the bundled development broker is 3.1.1 only,
# and the launcher sets 311 when it starts that one.
MQTT_PROTOCOL_VERSION=5
MQTT_KEEPALIVE=45
MQTT_QOS_UPLINK=1
MQTT_QOS_DOWNLINK=1
# Shared subscriptions let several ingestor replicas split the topic load.
MQTT_USE_SHARED_SUBSCRIPTION=1
MQTT_SHARED_GROUP=zqs-ingestor
# TLS (port 8883)
MQTT_TLS_ENABLED=0
# MQTT_TLS_CA_CERT=/etc/zqs/certs/ca.pem
# MQTT_TLS_CERTFILE=/etc/zqs/certs/client.pem
# MQTT_TLS_KEYFILE=/etc/zqs/certs/client.key
MQTT_TLS_INSECURE=0

# Shared secret EMQX sends in X-EMQX-Token when calling the auth/ACL webhooks.
# Leave empty to keep those endpoints disabled.
EMQX_WEBHOOK_TOKEN=

# ---- Workflows ----
# How many workflow runs one organisation may have going at once. A server
# setting on purpose: operators add and remove flows freely up to it, but
# cannot raise it, because what it protects is the machine everyone shares.
# SMTP for email notification channels. Each channel can also carry its own
# SMTP settings (set in the console), which take precedence. With neither,
# email channels refuse to send and say so - mail is never silently dropped.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=zqs-cloud@example.com

WORKFLOW_MAX_CONCURRENT_RUNS=12
# Engine tick. This is the resolution of every timer an operator draws.
WORKFLOW_TICK_SECONDS=2

# ---- Geocoding ----
# Address lookup when registering a site. Uses OpenStreetMap Nominatim (free,
# no key). Manual coordinate entry always works, so 0 degrades the feature
# rather than blocking anything.
GEOCODING_ENABLED=1
GEOCODING_USER_AGENT=ZQS-Cloud/1.0 (energy platform)

# ---- Sparkplug B ----
# Host Application ID. Must be unique per deployment sharing a broker.
SPARKPLUG_HOST_ID=zqs-cloud

# ---- Internal message bus ------------------------------------------------
# redis (default) | rabbitmq | memory (dev only, not durable)
BUS_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0
AMQP_URL=amqp://guest:guest@127.0.0.1:5672/%2F
BUS_STREAM_PREFIX=zqs
BUS_CONSUMER_GROUP=zqs-workers
BUS_MAX_STREAM_LENGTH=1000000
# How long a message may sit un-acked before another worker reclaims it.
BUS_CLAIM_MIN_IDLE_MS=60000

# ---- Cache ---------------------------------------------------------------
# locmem (default, per-process) | redis (shared across API replicas)
CACHE_BACKEND=locmem
# CACHE_REDIS_URL=redis://127.0.0.1:6379/1

# ---- Ingestion -----------------------------------------------------------
INGEST_MAX_SKEW_FUTURE_S=300
INGEST_MAX_SKEW_PAST_S=604800
INGEST_MAX_PAYLOAD_BYTES=262144
INGEST_MAX_METRICS_PER_MESSAGE=512
# Register unknown devices on first uplink instead of dropping their data.
INGEST_AUTO_PROVISION=0
INGEST_AUTO_PROVISION_ORG=default

# ---- Worker --------------------------------------------------------------
WORKER_BATCH_SIZE=500
WORKER_FLUSH_INTERVAL_MS=2000
WORKER_BLOCK_MS=1000
WORKER_REGISTRY_CACHE_TTL_S=30
WORKER_MAX_RETRIES=3

# ---- Device lifecycle ----------------------------------------------------
# Silence longer than this marks a device offline even with no last will.
DEVICE_OFFLINE_GRACE_SECONDS=180
COMMAND_DEFAULT_TIMEOUT_SECONDS=60

# ---- API -----------------------------------------------------------------
API_PAGE_SIZE=50
API_PAGE_MAX_SIZE=1000
PASSWORD_MIN_LENGTH=10
