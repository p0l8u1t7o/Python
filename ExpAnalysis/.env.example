# ── ExpAnalysis 環境設定範本 ─────────────────────────────
# 複製本檔為 .env 後修改。所有項目皆有預設值，未設定亦可執行。

# 資料庫檔案路徑（相對於專案根目錄或絕對路徑）
EXPA_DB_PATH=data/expanalysis.db

# HTTP 服務
EXPA_HOST=127.0.0.1
EXPA_PORT=8848

# 日誌
EXPA_LOG_LEVEL=INFO
EXPA_LOG_DIR=logs

# ── L5 AI 助理層 ────────────────────────────────────────
# provider: anthropic | openai | template
#   template = 不呼叫外部 API 的本地模板模式（離線可用，數字完全正確）
#   未填 API key 時一律自動退回 template，demo 不會因為沒網路而開天窗
EXPA_LLM_PROVIDER=anthropic
EXPA_ANTHROPIC_API_KEY=
EXPA_ANTHROPIC_MODEL=claude-sonnet-4-5
EXPA_OPENAI_API_KEY=
EXPA_OPENAI_MODEL=gpt-4o
EXPA_OPENAI_BASE_URL=https://api.openai.com/v1
EXPA_LLM_TIMEOUT_S=60

# ── 製程預設值 ──────────────────────────────────────────
# 6N 判定門檻（總雜質 ppm）
EXPA_PURITY_THRESHOLD_PPM=1.0
